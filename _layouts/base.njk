<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ pageTitle or title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="author" content="HUMAN REC">
    <meta name="robots" content="{% if draft %}noindex, nofollow{% else %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endif %}">
    <link rel="canonical" href="{{ canonical }}">

    <!-- Open Graph -->
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:title" content="{{ ogTitle or pageTitle or title }}">
    <meta property="og:description" content="{{ ogDescription or description }}">
    <meta property="og:image" content="{{ ogImage or 'https://humanrec.fr/images/og-image.webp' }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="HUMAN REC - Production Audiovisuelle">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ogTitle or pageTitle or title }}">
    <meta name="twitter:description" content="{{ ogDescription or description }}">
    <meta name="twitter:image" content="{{ ogImage or 'https://humanrec.fr/images/og-image.webp' }}">

    <!-- Theme -->
    <meta name="theme-color" content="#0a0a0a">

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicons/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://api.fontshare.com">
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap"></noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"></noscript>

    <!-- CSS site -->
    <link rel="stylesheet" href="/style.min.css">

    <!-- CSS spécifique blog -->
    <link rel="stylesheet" href="/css/blog.css">

    <!-- RSS feed pour les articles -->
    {% if isBlog %}
    <link rel="alternate" type="application/rss+xml" title="Blog HUMAN REC" href="/feed.xml">
    {% endif %}

    {% block extraHead %}{% endblock %}
</head>

<body>
    <a href="#main" class="skip-link">Aller au contenu</a>

    <!-- NAVIGATION -->
    <nav id="navbar">
        <a href="/" class="logo" aria-label="HUMAN REC - Retour à l'accueil">
            <span class="logo-dot"></span>
            <img src="/images/logo.webp" alt="HUMAN REC" class="logo-img">
        </a>
        <ul class="nav-menu">
            <li><a href="/services/">Services</a></li>
            <li><a href="/#portfolio">Réalisations</a></li>
            <li><a href="/blog/"{% if isBlog %} class="active" aria-current="page"{% endif %}>Blog</a></li>
            <li><a href="/qui-sommes-nous">L'équipe</a></li>
            <li><a href="/#contact">Contact</a></li>
            <li><a href="tel:+33783832507" class="nav-phone">07 83 83 25 07</a></li>
        </ul>
        <button class="menu-toggle" id="menuToggle" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </nav>

    <!-- MOBILE MENU -->
    <div class="mobile-menu" id="mobileMenu">
        <a href="/">Accueil</a>
        <a href="/services/">Services</a>
        <a href="/#portfolio">Réalisations</a>
        <a href="/blog/">Blog</a>
        <a href="/qui-sommes-nous">L'équipe</a>
        <a href="/#contact">Contact</a>
        <a href="tel:+33783832507" class="mobile-phone-link" style="color: var(--red); font-weight: 600; margin-top: 20px;">📞 07 83 83 25 07</a>
    </div>

    <main id="main">
        {% block content %}{% endblock %}
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="/" class="logo">
                    <img src="/images/logo.webp" alt="HUMAN REC" class="logo-img" loading="lazy">
                </a>
                <p>Production audiovisuelle basée dans le Vaucluse. Films publicitaires, promotionnels et événementiels.</p>
                <div class="social-links">
                    <a href="https://www.instagram.com/human_rec/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
