                    </a>
                    <a href="https://www.linkedin.com/company/103476613/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                    </a>
                    <a href="https://www.youtube.com/@humanrec-prod" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z" /></svg>
                    </a>
                </div>
            </div>
            <div class="footer-column">
                <h4>Navigation</h4>
                <ul>
                    <li><a href="/qui-sommes-nous">L'équipe</a></li>
                    <li><a href="/services/">Services</a></li>
                    <li><a href="/blog/">Blog</a></li>
                    <li><a href="/#portfolio">Réalisations</a></li>
                    <li><a href="/#contact">Contact</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Services</h4>
                <ul>
                    <li><a href="/services/film-publicitaire-avignon">Films publicitaires</a></li>
                    <li><a href="/services/video-promotionnelle-avignon">Vidéos Promotionnelles</a></li>
                    <li><a href="/services/captation-evenementielle-avignon">Captation événementielle</a></li>
                    <li><a href="/production-video-avignon">Production vidéo Avignon</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Légal</h4>
                <ul>
                    <li><a href="/mentions-legales">Mentions légales</a></li>
                    <li><a href="/politique-confidentialite">Confidentialité</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 HUMAN REC. Tous droits réservés.</p>
            <p>Fait à <a href="/">Avignon</a>. Pour durer.</p>
        </div>
    </footer>

    <script src="/js/main.min.js" defer></script>

    {% block extraScripts %}{% endblock %}
</body>

</html>
